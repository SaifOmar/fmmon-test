build/darwin/*.png
build/darwin/*.icns
build/darwin/*.car
build/linux/appimage/

# Wails generated bindings and frontend build (regenerated every build)
frontend/bindings/
frontend/dist/

# IDE / OS
*.rdi
.DS_Store
